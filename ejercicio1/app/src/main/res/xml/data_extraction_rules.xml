<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no bloquea la transferencia entre dispositivos.
     Se excluyen las preferencias cifradas porque su clave del Keystore no se copia. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_geo_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_geo_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
